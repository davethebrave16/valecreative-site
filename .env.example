PUBLIC_FIREBASE_API_KEY=your_api_key_here
PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=your_project_id
PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
PUBLIC_FIREBASE_APP_ID=your_app_id

# Google reCAPTCHA v3 site key (public) — get from https://www.google.com/recaptcha/admin
PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Google Analytics 4 — get from GA4 → Admin → Data Streams → Web stream → Measurement ID
# Leave empty or omit to disable analytics (no script injected)
VITE_GA_MEASUREMENT_ID=

# Meta Pixel (Facebook Pixel) — Business Manager → Eventi → Pixel
# Leave empty or omit to disable the Meta Pixel (no script injected)
PUBLIC_META_PIXEL_ID=
