---
import '../styles/global.css'
import { useTranslations, getLocalePath } from '@/i18n/utils'
import CookieConsentBanner from '@/components/CookieConsentBanner.astro'

interface Props {
	title: string
	description?: string
	lang?: string
	ogImage?: string
	ogType?: 'website' | 'article'
}

const {
	title,
	description = 'Vale Creative — il portfolio di Valentina Damiano',
	lang,
	ogImage,
	ogType = 'website',
} = Astro.props

const locale = lang ?? Astro.currentLocale ?? 'it'
const t = useTranslations(locale)
const p = (path: string) => getLocalePath(locale, path)

const pathname = Astro.url.pathname
const isActive = (href: string) =>
	href === p('/') ? pathname === p('/') || pathname === p('') : pathname.startsWith(href)

const navLinks = [
	{ label: t.nav.home, href: p('/') },
	{ label: t.nav.works, href: p('/works') },
	{ label: t.nav.techniques, href: p('/techniques') },
	{ label: t.nav.about, href: p('/about') },
]

const year = new Date().getFullYear()

const SITE = 'https://valentinadamiano.it'
const gaId = import.meta.env.VITE_GA_MEASUREMENT_ID ?? null
const recaptchaSiteKey = import.meta.env.PUBLIC_RECAPTCHA_SITE_KEY ?? null

const canonicalUrl = `${SITE}${pathname}`

// Both locales are always prefixed (/it/*, /en/*), so the counterpart URL is just a prefix swap.
const otherLocale = locale === 'it' ? 'en' : 'it'
const itUrl = `${SITE}${pathname.replace(/^\/(it|en)/, '/it')}`
const enUrl = `${SITE}${pathname.replace(/^\/(it|en)/, '/en')}`

// Relative (origin-agnostic) path for the visible switcher, so it stays on the current host
// (localhost in dev, the real domain in prod) instead of the absolute SITE used for hreflang.
const switchPath = pathname.replace(/^\/(it|en)/, `/${otherLocale}`)
const itHref = locale === 'it' ? pathname : switchPath
const enHref = locale === 'en' ? pathname : switchPath

const resolvedOgImage = ogImage ?? `${SITE}/og-default.jpg`
const pageTitle = `${title} — Vale Creative`
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#2e403a" />
		<title>{pageTitle}</title>

		<!-- Canonical -->
		<link rel="canonical" href={canonicalUrl} />

		<!-- Hreflang alternates. x-default points at the root language gateway (src/pages/index.astro),
		     which picks /it or /en for the visitor rather than assuming Italian. -->
		<link rel="alternate" hreflang="it" href={itUrl} />
		<link rel="alternate" hreflang="en" href={enUrl} />
		<link rel="alternate" hreflang="x-default" href={`${SITE}/`} />

		<!-- Open Graph -->
		<meta property="og:site_name" content="Vale Creative" />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={resolvedOgImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:locale" content={locale === 'it' ? 'it_IT' : 'en_US'} />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={resolvedOgImage} />

		<!-- Favicons -->
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Hanken+Grotesk:wght@300;400;500;600;700&family=Spline+Sans+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>

		<!-- Google Analytics 4 — loaded, but disabled until CookieConsentBanner confirms consent -->
		{gaId && (
			<>
				<script define:vars={{ gaId }}>
					window[`ga-disable-${gaId}`] = true
					window.dataLayer = window.dataLayer || []
					function gtag() { dataLayer.push(arguments) }
					gtag('js', new Date())
				</script>
				<script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
			</>
		)}

		<!-- Google reCAPTCHA v3 -->
		{recaptchaSiteKey && (
			<script async defer src={`https://www.google.com/recaptcha/api.js?render=${recaptchaSiteKey}`}></script>
		)}

		<!-- Per-page JSON-LD and other head additions -->
		<slot name="head" />
	</head>
	<body data-recaptcha-key={recaptchaSiteKey ?? ''}>

		<header id="vd-header" style="position:sticky;top:0;z-index:40;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);background:rgba(239,231,214,.82);border-bottom:1px solid var(--line)">
			<div style="max-width:1320px;margin:0 auto;padding:14px clamp(18px,4vw,52px);display:flex;align-items:center;justify-content:space-between;gap:20px">

				<!-- Logo -->
				<a href={p('/')} style="display:flex;align-items:center;gap:12px;text-decoration:none">
					<img src="/logo512.png" alt="Valentina Damiano" width="42" height="42" style="border-radius:50%;flex:none" />
					<span style="display:flex;flex-direction:column;align-items:flex-start;line-height:1">
						<span style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:20px;letter-spacing:.01em;color:var(--ink)">Valentina Damiano</span>
						<span style="font-family:'Spline Sans Mono',monospace;font-size:9.5px;letter-spacing:.26em;text-transform:uppercase;color:var(--muted);margin-top:3px">{t.footer.tagline}</span>
					</span>
				</a>

				<!-- Desktop nav -->
				<nav class="vd-desk" style="align-items:center;gap:clamp(14px,1.8vw,30px)">
					{navLinks.map((link) => (
						<a
							class="vd-navlink"
							href={link.href}
							data-active={isActive(link.href) ? '' : undefined}
						>
							{link.label}
						</a>
					))}
					<a
						href={p('/contact')}
						style="font-family:'Hanken Grotesk',sans-serif;font-size:13.5px;font-weight:600;padding:9px 18px;border:1px solid var(--verde);border-radius:999px;color:var(--verde);transition:background .2s,color .2s"
						onmouseover="this.style.background='var(--verde)';this.style.color='#fff'"
						onmouseout="this.style.background='';this.style.color='var(--verde)'"
					>
						{t.nav.contact}
					</a>
					<div class="vd-langswitch" aria-label="Language">
						<a href={itHref} class="vd-langswitch-link" data-locale="it" aria-current={locale === 'it' ? 'true' : undefined}>IT</a>
						<span class="vd-langswitch-sep" aria-hidden="true">/</span>
						<a href={enHref} class="vd-langswitch-link" data-locale="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
					</div>
				</nav>

				<!-- Burger button -->
				<button
					class="vd-burger"
					id="vd-burger"
					aria-label="Menu"
					aria-expanded="false"
					style="align-items:center;justify-content:center;width:42px;height:42px;border:1px solid var(--line);border-radius:10px;background:var(--parchment)"
				>
					<span style="display:block;width:18px;height:11px;border-top:1.6px solid var(--ink);border-bottom:1.6px solid var(--ink);position:relative">
						<span style="position:absolute;top:4px;left:0;right:0;height:1.6px;background:var(--ink)"></span>
					</span>
				</button>

			</div>

			<!-- Mobile menu -->
			<div id="vd-menu" style="display:none;border-top:1px solid var(--line);background:var(--parchment);padding:8px clamp(18px,4vw,52px) 18px;flex-direction:column">
				{navLinks.map((link) => (
					<a
						href={link.href}
						style={`padding:13px 2px;font-size:17px;font-weight:${isActive(link.href) ? 600 : 500};color:${isActive(link.href) ? 'var(--verde)' : 'var(--ink)'};border-bottom:1px solid var(--line);font-family:'Cormorant Garamond',serif;text-decoration:none;display:block`}
					>
						{link.label}
					</a>
				))}
				<a
					href={p('/contact')}
					style="padding:13px 2px;font-size:17px;font-weight:600;color:var(--verde);border-bottom:1px solid var(--line);font-family:'Cormorant Garamond',serif;text-decoration:none;display:block"
				>
					{t.nav.contact}
				</a>
				<div class="vd-langswitch" style="padding:13px 2px" aria-label="Language">
					<a href={itHref} class="vd-langswitch-link" data-locale="it" aria-current={locale === 'it' ? 'true' : undefined}>IT</a>
					<span class="vd-langswitch-sep" aria-hidden="true">/</span>
					<a href={enHref} class="vd-langswitch-link" data-locale="en" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
				</div>
			</div>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<div style="max-width:1320px;margin:0 auto;padding:clamp(40px,5vw,70px) clamp(18px,4vw,52px) 34px;position:relative">
				<div style="display:grid;grid-template-columns:1fr;gap:30px">
					<div style="display:flex;align-items:center;gap:14px">
						<img src="/logowhite512.png" alt="" width="52" height="52" style="border-radius:50%" />
						<div>
							<div style="font-family:'Cormorant Garamond',serif;font-size:22px;font-weight:600;color:#f3ecdc">Valentina Damiano</div>
							<div style="font-family:'Spline Sans Mono',monospace;font-size:10px;letter-spacing:.2em;text-transform:uppercase;color:var(--gold-soft);margin-top:3px">{t.footer.tagline}</div>
						</div>
					</div>
					<nav style="display:flex;flex-wrap:wrap;gap:18px 26px">
						{navLinks.map((link) => (
							<a href={link.href} style="font-size:14px;color:#cfc8b6;text-decoration:none;transition:color .2s" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#cfc8b6'">
								{link.label}
							</a>
						))}
						<a href={p('/contact')} style="font-size:14px;color:#cfc8b6;text-decoration:none;transition:color .2s" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#cfc8b6'">
							{t.nav.contact}
						</a>
						<a href={p('/privacy')} style="font-size:14px;color:#cfc8b6;text-decoration:none;transition:color .2s" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#cfc8b6'">
							{t.nav.privacy}
						</a>
					</nav>
				</div>
				<div style="display:flex;align-items:center;gap:16px;margin:34px 0 0;padding-top:20px;border-top:1px solid rgba(255,255,255,.12)">
					<span style="flex:1;font-family:'Spline Sans Mono',monospace;font-size:11px;letter-spacing:.06em;color:#8f897b">{t.footer.copyright(year)}</span>
					<nav style="display:flex;align-items:center;gap:16px">
						<a href="https://www.instagram.com/vale_creat1ve" target="_blank" rel="noopener noreferrer" aria-label="Instagram" style="color:#cfc8b6;transition:color .2s;display:flex" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#cfc8b6'">
							<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C8.74 0 8.333.014 7.053.072 5.775.132 4.905.333 4.14.63c-.789.306-1.459.717-2.126 1.384S.935 3.35.63 4.14C.333 4.905.131 5.775.072 7.053.014 8.333 0 8.74 0 12s.014 3.667.072 4.947c.06 1.277.261 2.148.558 2.913.306.788.717 1.459 1.384 2.126.667.666 1.336 1.079 2.126 1.384.766.296 1.636.499 2.913.558C8.333 23.986 8.74 24 12 24s3.667-.014 4.947-.072c1.277-.06 2.148-.262 2.913-.558.788-.306 1.459-.718 2.126-1.384.666-.667 1.079-1.335 1.384-2.126.296-.765.499-1.636.558-2.913.06-1.28.072-1.687.072-4.947s-.014-3.667-.072-4.947c-.06-1.277-.262-2.149-.558-2.913-.306-.789-.718-1.459-1.384-2.126C21.319 1.347 20.651.935 19.86.63c-.765-.297-1.636-.499-2.913-.558C15.667.014 15.26 0 12 0zm0 2.16c3.203 0 3.585.016 4.85.071 1.17.055 1.805.249 2.227.415.562.217.96.477 1.382.896.419.42.679.819.896 1.381.164.422.36 1.057.413 2.227.057 1.266.07 1.646.07 4.85s-.015 3.585-.074 4.85c-.061 1.17-.256 1.805-.421 2.227-.224.562-.479.96-.899 1.382-.419.419-.824.679-1.38.896-.42.164-1.065.36-2.235.413-1.274.057-1.649.07-4.859.07-3.211 0-3.586-.015-4.859-.074-1.171-.061-1.816-.256-2.236-.421-.569-.224-.96-.479-1.379-.899-.421-.419-.69-.824-.9-1.38-.165-.42-.359-1.065-.42-2.235-.045-1.26-.061-1.649-.061-4.844 0-3.196.016-3.586.061-4.861.061-1.17.255-1.814.42-2.234.21-.57.479-.96.9-1.381.419-.419.81-.689 1.379-.898.42-.166 1.051-.361 2.221-.421 1.275-.045 1.65-.06 4.859-.06l.045.03zm0 3.678c-3.405 0-6.162 2.76-6.162 6.162 0 3.405 2.76 6.162 6.162 6.162 3.405 0 6.162-2.76 6.162-6.162 0-3.405-2.76-6.162-6.162-6.162zM12 16c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4zm7.846-10.405c0 .795-.646 1.44-1.44 1.44-.795 0-1.44-.646-1.44-1.44 0-.795.646-1.439 1.44-1.439.793-.001 1.44.644 1.44 1.439z"/></svg>
						</a>
						<a href="https://www.facebook.com/universeofmine" target="_blank" rel="noopener noreferrer" aria-label="Facebook" style="color:#cfc8b6;transition:color .2s;display:flex" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#cfc8b6'">
							<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
						</a>
						<a href="https://pin.it/1rYKUcha3" target="_blank" rel="noopener noreferrer" aria-label="Pinterest" style="color:#cfc8b6;transition:color .2s;display:flex" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='#cfc8b6'">
							<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M0 12c0 5.123 3.211 9.497 7.73 11.218-.11-.937-.203-2.35.043-3.362.223-.923 1.436-5.87 1.436-5.87s-.366-.734-.366-1.818c0-1.704.988-2.977 2.219-2.977 1.046 0 1.552.785 1.552 1.727 0 1.052-.67 2.622-1.016 4.078-.29 1.219.61 2.213 1.813 2.213 2.176 0 3.85-2.294 3.85-5.606 0-2.933-2.107-4.983-5.113-4.983-3.483 0-5.53 2.612-5.53 5.31 0 1.052.405 2.181.911 2.793a.366.366 0 0 1 .085.35c-.093.387-.3 1.219-.34 1.389-.053.222-.175.269-.405.162-1.51-.703-2.454-2.911-2.454-4.688 0-3.816 2.771-7.32 7.994-7.32 4.197 0 7.458 2.99 7.458 6.982 0 4.163-2.625 7.512-6.269 7.512-1.224 0-2.375-.636-2.769-1.386l-.753 2.871c-.273 1.047-1.01 2.359-1.504 3.16 1.132.35 2.335.539 3.583.539 6.627 0 12-5.373 12-12S18.627 0 12 0 0 5.373 0 12z"/></svg>
						</a>
					</nav>
				</div>
			</div>
		</footer>

		<script>
			const burger = document.getElementById('vd-burger')
			const menu = document.getElementById('vd-menu')
			if (burger && menu) {
				burger.addEventListener('click', () => {
					const open = menu.style.display === 'flex'
					menu.style.display = open ? 'none' : 'flex'
					burger.setAttribute('aria-expanded', String(!open))
				})
			}

			// "Back" breadcrumb links (e.g. "← All works") should return to wherever the visitor
			// actually came from (a category page, a search result, etc.) rather than always
			// resetting to the fixed href. Falls back to the href for direct loads/new tabs/crawlers,
			// where there's no in-app history to go back to.
			document.querySelectorAll('[data-back-link]').forEach((link) => {
				link.addEventListener('click', (e) => {
					if (window.history.length > 1) {
						e.preventDefault()
						window.history.back()
					}
				})
			})

			// Remember a manual language choice so the auto-redirect script never overrides it.
			document.querySelectorAll('.vd-langswitch-link').forEach((link) => {
				link.addEventListener('click', () => {
					const targetLocale = link.getAttribute('data-locale')
					if (targetLocale) {
						try {
							localStorage.setItem('vd-locale', targetLocale)
						} catch (e) {}
					}
				})
			})
		</script>

		{gaId && <CookieConsentBanner locale={locale} gaId={gaId} t={t} />}

	</body>
</html>
