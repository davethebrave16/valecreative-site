---
import { getLocalePath } from '@/i18n/utils'

interface Props {
	locale: string
	gaId: string | null
	pixelId: string | null
	t: {
		cookieConsent: {
			text: string
			learnMore: string
			accept: string
			reject: string
			customize: string
			save: string
			statisticsLabel: string
			statisticsDescription: string
			marketingLabel: string
			marketingDescription: string
		}
	}
}

const { locale, gaId, pixelId, t } = Astro.props
const c = t.cookieConsent
const privacyHref = getLocalePath(locale, '/privacy')
// Accept and Reject share the same style on purpose (equal prominence).
const choiceButtonStyle = 'padding:10px 20px;font-size:13.5px;font-weight:600;border-radius:999px;border:1px solid #f3ecdc;background:#f3ecdc;color:var(--forest);cursor:pointer'
const secondaryButtonStyle = 'padding:10px 18px;font-size:13.5px;font-weight:600;border-radius:999px;border:1px solid rgba(255,255,255,.35);background:transparent;color:#f3ecdc;cursor:pointer'
const categories = [
	...(gaId ? [{ id: 'analytics', label: c.statisticsLabel, description: c.statisticsDescription }] : []),
	...(pixelId ? [{ id: 'marketing', label: c.marketingLabel, description: c.marketingDescription }] : []),
]
---

<div
	id="vd-cookie-banner"
	data-ga-id={gaId}
	data-pixel-id={pixelId}
	role="region"
	aria-label={c.customize}
	style="display:none;position:fixed;left:0;right:0;bottom:0;z-index:60;background:var(--forest);border-top:1px solid rgba(255,255,255,.12);padding:16px clamp(18px,4vw,52px);font-family:'Hanken Grotesk',sans-serif"
>
	<div style="max-width:1320px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:14px 24px;justify-content:space-between">
		<p style="margin:0;flex:1 1 320px;font-size:13.5px;line-height:1.6;color:#f3ecdc">
			{c.text}
			{' '}
			<a href={privacyHref} style="color:var(--gold-soft);text-decoration:underline">{c.learnMore}</a>
		</p>
		<div style="display:flex;flex-wrap:wrap;gap:10px;flex:none">
			<button type="button" id="vd-cookie-customize" aria-expanded="false" aria-controls="vd-cookie-panel" style={secondaryButtonStyle}>{c.customize}</button>
			<button type="button" id="vd-cookie-reject" style={choiceButtonStyle}>{c.reject}</button>
			<button type="button" id="vd-cookie-accept" style={choiceButtonStyle}>{c.accept}</button>
		</div>
	</div>

	<!-- Per-category choice: both switches off by default -->
	<div id="vd-cookie-panel" hidden style="max-width:1320px;margin:14px auto 0;padding-top:14px;border-top:1px solid rgba(255,255,255,.12)">
		{categories.map((cat) => (
			<label style="display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:10px 0;color:#f3ecdc;cursor:pointer">
				<span>
					<span style="display:block;font-size:14px;font-weight:600">{cat.label}</span>
					<span style="display:block;font-size:13px;line-height:1.5;color:#cfc8b6;margin-top:2px">{cat.description}</span>
				</span>
				<input type="checkbox" role="switch" data-consent-category={cat.id} style="flex:none;width:22px;height:22px;margin-top:2px;accent-color:var(--gold-soft);cursor:pointer" />
			</label>
		))}
		<div style="display:flex;justify-content:flex-end;margin-top:8px">
			<button type="button" id="vd-cookie-save" style={choiceButtonStyle}>{c.save}</button>
		</div>
	</div>
</div>

<script>
	import { readConsent, writeConsent, type Consent } from '@/lib/consent'

	const banner = document.getElementById('vd-cookie-banner')
	const panel = document.getElementById('vd-cookie-panel')
	const customizeBtn = document.getElementById('vd-cookie-customize')
	const gaId = banner?.dataset.gaId
	const pixelId = banner?.dataset.pixelId

	// Third-party scripts are only fetched after consent. BaseLayout defines the gtag/fbq stubs up
	// front, so the calls below are queued and replayed in order once the library loads.
	function injectScript(src: string) {
		if (document.querySelector(`script[src="${src}"]`)) return
		const script = document.createElement('script')
		script.async = true
		script.src = src
		document.head.appendChild(script)
	}

	// Returning visitors with stored consent: fetch after window load so the scripts never compete
	// with the LCP image. The config/init calls are queued immediately, so no page view is lost.
	function afterLoad(fn: () => void) {
		if (document.readyState === 'complete') fn()
		else window.addEventListener('load', fn, { once: true })
	}

	function load(src: string, deferLoad: boolean) {
		if (deferLoad) afterLoad(() => injectScript(src))
		else injectScript(src)
	}

	function enableGa(id: string, deferLoad: boolean) {
		;(window as Window & { [key: string]: unknown })[`ga-disable-${id}`] = false
		const gtag = (window as Window & { gtag?: Function }).gtag
		if (typeof gtag === 'function') gtag('config', id)
		load(`https://www.googletagmanager.com/gtag/js?id=${id}`, deferLoad)
	}

	function disableGa(id: string) {
		;(window as Window & { [key: string]: unknown })[`ga-disable-${id}`] = true
	}

	function enableFbq(id: string, deferLoad: boolean) {
		const fbq = (window as Window & { fbq?: Function }).fbq
		if (typeof fbq === 'function') {
			fbq('init', id)
			fbq('track', 'PageView')
		}
		load('https://connect.facebook.net/en_US/fbevents.js', deferLoad)
	}

	// First-party cookies set by each service, removed when that category is revoked.
	const CATEGORY_COOKIES: Record<keyof Consent, (name: string) => boolean> = {
		analytics: (name) => name === '_ga' || name.startsWith('_ga_'),
		marketing: (name) => name === '_fbp' || name === '_fbc',
	}

	function deleteCookies(matches: (name: string) => boolean) {
		const names = document.cookie.split(';').map((c) => c.split('=')[0].trim()).filter(matches)
		// GA/Pixel set them on the registrable domain (e.g. .valentinadamiano.it): try every parent domain.
		const parts = location.hostname.split('.')
		const domains = ['', ...parts.map((_, i) => parts.slice(i).join('.')).filter((d) => d.includes('.'))]
		for (const name of names) {
			for (const domain of domains) {
				document.cookie = `${name}=; Max-Age=0; path=/${domain ? `; domain=${domain}` : ''}`
			}
		}
	}

	function setPanelOpen(open: boolean) {
		if (!panel || !customizeBtn) return
		panel.hidden = !open
		customizeBtn.setAttribute('aria-expanded', String(open))
	}

	function openPreferences() {
		if (!banner) return
		const current = readConsent() ?? { analytics: false, marketing: false }
		document.querySelectorAll<HTMLInputElement>('[data-consent-category]').forEach((input) => {
			input.checked = current[input.dataset.consentCategory as keyof Consent] === true
		})
		setPanelOpen(true)
		banner.style.display = 'block'
	}

	// Apply a new choice. Newly granted categories load right away (page_view / PageView for THIS page);
	// a revoked category deletes its first-party cookies and reloads, so no library stays in memory.
	function saveConsent(next: Consent) {
		const previous = readConsent() ?? { analytics: false, marketing: false }
		writeConsent(next)
		const revoked = (Object.keys(next) as (keyof Consent)[]).filter((k) => previous[k] && !next[k])
		if (revoked.length > 0) {
			revoked.forEach((category) => deleteCookies(CATEGORY_COOKIES[category]))
			location.reload()
			return
		}
		if (gaId && next.analytics && !previous.analytics) enableGa(gaId, false)
		if (pixelId && next.marketing && !previous.marketing) enableFbq(pixelId, false)
		if (banner) banner.style.display = 'none'
		setPanelOpen(false)
	}

	if (banner && (gaId || pixelId)) {
		const consent = readConsent()

		if (consent) {
			// Returning visitor: same behaviour as before, now per category.
			if (gaId) {
				if (consent.analytics) enableGa(gaId, true)
				else disableGa(gaId)
			}
			if (pixelId && consent.marketing) enableFbq(pixelId, true)
		} else {
			if (gaId) disableGa(gaId)
			banner.style.display = 'block'
		}

		document.getElementById('vd-cookie-accept')?.addEventListener('click', () => {
			saveConsent({ analytics: true, marketing: true })
		})

		document.getElementById('vd-cookie-reject')?.addEventListener('click', () => {
			saveConsent({ analytics: false, marketing: false })
		})

		customizeBtn?.addEventListener('click', () => {
			if (panel?.hidden) openPreferences()
			else setPanelOpen(false)
		})

		document.getElementById('vd-cookie-save')?.addEventListener('click', () => {
			const checked = (category: keyof Consent) =>
				document.querySelector<HTMLInputElement>(`[data-consent-category="${category}"]`)?.checked === true
			saveConsent({ analytics: checked('analytics'), marketing: checked('marketing') })
		})
	}

	// "Cookie preferences" in the footer and "manage preferences" on the privacy page reopen the panel
	// with the current choice; revocation happens when the visitor saves.
	document.querySelectorAll('[data-manage-cookie-consent]').forEach((el) => {
		el.addEventListener('click', (event) => {
			event.preventDefault()
			openPreferences()
		})
	})
</script>
