---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getArtworks, getPublishedSeries, getContentBySlug, getCategories } from '@/lib/fetchContent'
import { useTranslations, getLocalePath, type Locale } from '@/i18n/utils'
import { sortByPosition, pickHeroArtwork } from '@/lib/utils'
import { Picture, Image } from 'astro:assets'
import RemoteImage from '@/components/RemoteImage.astro'
import { IMAGE_SIZES, IMAGE_ASPECTS, gridImageProps, getRemoteSrcset, getOgImage } from '@/lib/remoteImage'
import logoWhite from '@/assets/logo-white.png'
import { processImages, stepImageKeys } from '@/lib/processImages'

interface Props {
	locale: string
}

const { locale } = Astro.props
const t = useTranslations(locale)
const p = (path: string) => getLocalePath(locale, path)
const SITE = 'https://valentinadamiano.it'

const [allArtworks, series, hero, categories] = await Promise.all([
	getArtworks(locale as Locale),
	getPublishedSeries(),
	getContentBySlug('homepage_hero', locale as Locale),
	getCategories(locale as Locale),
])
const categoryById = Object.fromEntries(categories.map(c => [c.id, c.name]))

const featuredArtworks = sortByPosition(allArtworks.filter((a) => a.featured), 'featuredPosition')
const heroArtwork = pickHeroArtwork(allArtworks)
const introArtwork = allArtworks.find((a) => a.isIntro)

// Count artworks per series for the series teaser
const artworkCountBySeries: Record<string, number> = {}
for (const a of allArtworks) {
	if (a.seriesId) artworkCountBySeries[a.seriesId] = (artworkCountBySeries[a.seriesId] ?? 0) + 1
}

function getOrientation(dims?: { width?: number; height?: number }) {
	if (!dims?.width || !dims?.height) return 'square'
	const r = dims.width / dims.height
	if (r < 0.85) return 'portrait'
	if (r > 1.2) return 'landscape'
	return 'square'
}

function cellGridStyle(orient: string) {
	if (orient === 'portrait') return 'grid-row:span 3'
	if (orient === 'landscape') return 'grid-row:span 2;grid-column:span 2'
	return 'grid-row:span 2'
}

// Preload the LCP hero with the same AVIF srcset <RemoteImage> renders (identical transform options).
const heroImage = heroArtwork?.coverImage?.original ? heroArtwork.coverImage : undefined
const heroPreloadSrcset = heroImage ? await getRemoteSrcset(heroImage, 'avif', IMAGE_ASPECTS.homeHero) : ''
const ogImage = await getOgImage(heroImage)

const heroTitle = hero?.title ?? t.home.heroTitle
const heroBody = hero?.body

const pageTitle = locale === 'it'
	? 'Valentina Damiano — Artista, Pittrice e Artigiana'
	: 'Valentina Damiano — Artist, Painter and Craftsperson'
const jobTitle = locale === 'it' ? 'Pittrice e Incisore' : 'Painter and Engraver'
const region = locale === 'it' ? 'Toscana' : 'Tuscany'
---

<BaseLayout
	title={pageTitle}
	lang={locale}
	description={t.meta.homeDescription}
	ogImage={ogImage?.url}
	ogImageWidth={ogImage?.width}
	ogImageHeight={ogImage?.height}
>
	{heroPreloadSrcset && (
		<link slot="head" rel="preload" as="image" type="image/avif" imagesrcset={heroPreloadSrcset} imagesizes={IMAGE_SIZES.homeHero} fetchpriority="high" />
	)}
	<script slot="head" type="application/ld+json" set:html={JSON.stringify({
		'@context': 'https://schema.org',
		'@graph': [
			{
				'@type': 'WebSite',
				'@id': `${SITE}/#website`,
				url: SITE,
				name: 'Vale Creative — Valentina Damiano',
				inLanguage: locale === 'it' ? 'it-IT' : 'en-US',
			},
			{
				'@type': 'Person',
				'@id': `${SITE}/#person`,
				name: 'Valentina Damiano',
				url: `${SITE}${p('/about')}`,
				jobTitle,
				email: 'studio@valentinadamiano.it',
				address: {
					'@type': 'PostalAddress',
					addressLocality: 'Pisa',
					addressRegion: region,
					addressCountry: 'IT',
				},
				sameAs: ['https://www.instagram.com/vale_creat1ve'],
			},
		],
	})} />


	<!-- ── Hero ── -->
	<section style="position:relative;overflow:hidden">
		<div style="position:absolute;inset:0;background:radial-gradient(130% 90% at 78% 8%,rgba(216,185,106,.42),rgba(239,231,214,0) 46%),radial-gradient(120% 100% at 8% 100%,rgba(46,64,58,.34),rgba(239,231,214,0) 50%);pointer-events:none"></div>
		<div class="container" style="padding-block:clamp(40px,6vw,92px) clamp(34px,4vw,64px);position:relative">
			<div class="vd-hero">
				<!-- Hero columns use vd-rise-move (transform only): the h1 and the LCP image are visible from the first paint -->
				<div class="vd-rise-move">
					<div style="display:flex;align-items:center;gap:12px;margin-bottom:22px">
						<span style="width:30px;height:1px;background:var(--gold)"></span>
						<span style="font-family:'Spline Sans Mono',monospace;font-size:11px;letter-spacing:.28em;text-transform:uppercase;color:var(--bark)">{t.home.eyebrow}</span>
					</div>
					{heroBody ? (
						<h1 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(44px,8vw,94px);line-height:.95;letter-spacing:-.01em;margin:0;color:var(--ink)" set:html={heroBody} />
					) : (
						<h1 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(44px,8vw,94px);line-height:.95;letter-spacing:-.01em;margin:0;color:var(--ink)">
							{heroTitle}
						</h1>
					)}
					<p style="max-width:46ch;margin:26px 0 0;font-size:clamp(16px,1.6vw,18.5px);line-height:1.7;color:#41463d">{t.home.heroSubtitle}</p>
					<p style="max-width:46ch;margin:14px 0 0;font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(18px,1.9vw,21px);line-height:1.5;color:var(--bark)">{t.home.heroOffer}</p>
					<div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:34px">
						<a href={p('/contact?type=commission')} class="vd-btn-primary">{t.home.ctaCommission} <span>→</span></a>
						<a href={p('/works')} class="vd-btn-outline">{t.home.ctaWorks}</a>
					</div>
				</div>

				<!-- Hero image: first featured artwork or gradient placeholder -->
				<div class="vd-rise-move" style="position:relative">
					<div style="position:relative;aspect-ratio:4/5;border-radius:4px;overflow:hidden;border:1px solid var(--line);box-shadow:0 30px 70px -36px rgba(31,42,34,.6)">
						{heroImage ? (
							<RemoteImage
								image={heroImage}
								alt={heroImage.alt ?? heroArtwork!.title}
								sizes={IMAGE_SIZES.homeHero}
								aspect={IMAGE_ASPECTS.homeHero}
								priority
								style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
							/>
						) : (
							<div style="position:absolute;inset:0;background:radial-gradient(130% 120% at 30% 14%,#d9b25e 0%,#6b4f37 44%,#243029 100%)"></div>
						)}
						<div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,0) 55%,rgba(20,28,22,.55))"></div>
						{heroArtwork && (
							<div style="position:absolute;left:18px;right:18px;bottom:16px;color:#fff">
								<div style="font-family:'Cormorant Garamond',serif;font-size:26px;font-weight:600">{heroArtwork.title}</div>
								<div style="font-family:'Spline Sans Mono',monospace;font-size:11px;letter-spacing:.1em;opacity:.85;margin-top:3px">{heroArtwork.year}</div>
							</div>
						)}
					</div>
					<div style="position:absolute;left:-18px;bottom:-18px;width:96px;height:96px;border-radius:50%;background:conic-gradient(from 200deg,var(--rose),var(--syellow),var(--sblue),var(--rose));filter:blur(26px);opacity:.32;z-index:-1"></div>
				</div>
			</div>
		</div>
	</section>

	<!-- ── Ornamental divider ── -->
	<div class="container">
		<div class="vd-divider" style="padding:clamp(34px,5vw,58px) 0 clamp(20px,2vw,28px)">
			<span class="vd-divider-line"></span>
			<span class="vd-divider-diamond"></span>
			<span class="vd-divider-line"></span>
		</div>
	</div>

	<!-- ── Featured works ── -->
	{featuredArtworks.length > 0 && (
		<section style="padding-bottom:clamp(30px,4vw,56px)">
			<div class="container">
				<div style="display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:26px">
					<div>
						<div class="vd-eyebrow">{t.home.featuredEyebrow}</div>
						<h2 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(28px,4vw,44px);margin:8px 0 0;color:var(--ink)">{t.home.featuredTitle}</h2>
					</div>
					<a href={p('/works')} style="font-weight:600;font-size:14px;color:var(--verde-deep);white-space:nowrap;transition:color .2s" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--verde-deep)'">{t.home.featuredLink}</a>
				</div>
				<div class="vd-grid">
					{featuredArtworks.map((artwork) => {
						const orient = getOrientation(artwork.dimensions)
						const cover = artwork.coverImage?.original ? artwork.coverImage : undefined
						return (
							<a
								href={p(`/works/${artwork.slug}`)}
								class="vd-cell"
								style={cellGridStyle(orient)}
							>
								{cover ? (
									<RemoteImage
										image={cover}
										alt={cover.alt ?? artwork.title}
										{...gridImageProps(orient)}
										class="vd-img"
										style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
									/>
								) : (
									<div class="vd-img" style={`position:absolute;inset:0;background:radial-gradient(130% 120% at 30% 14%,#d9b25e 0%,#6b4f37 44%,#243029 100%)`}></div>
								)}
								{artwork.categoryIds?.[0] && categoryById[artwork.categoryIds[0]] && (
									<>
										<!-- Dark scrim behind the category label: keeps it ≥4.5:1 even over a white artwork -->
										<div aria-hidden="true" style="position:absolute;inset:0 0 auto 0;height:45%;background:linear-gradient(180deg,rgba(18,26,20,.7) 0%,rgba(18,26,20,.7) 35%,rgba(18,26,20,0) 100%);z-index:1;pointer-events:none"></div>
										<span style="position:absolute;left:11px;top:9px;font-family:'Spline Sans Mono',monospace;font-size:9px;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.92);z-index:2">[ {categoryById[artwork.categoryIds[0]]} ]</span>
									</>
								)}
								<div class="vd-cap" style="position:absolute;inset:0;display:flex;flex-direction:column;justify-content:flex-end;padding:14px;background:linear-gradient(180deg,rgba(0,0,0,0) 45%,rgba(18,26,20,.74));z-index:2">
									<div style="font-family:'Cormorant Garamond',serif;font-size:21px;font-weight:600;color:#fff;line-height:1.05">{artwork.title}</div>
									<div style="font-family:'Spline Sans Mono',monospace;font-size:10px;letter-spacing:.08em;color:rgba(255,255,255,.82);margin-top:4px">{artwork.year}</div>
								</div>
							</a>
						)
					})}
				</div>
			</div>
		</section>
	)}

	<!-- ── Ornamental divider ── -->
	<div class="container">
		<div class="vd-divider" style="padding:clamp(4px,1vw,12px) 0 clamp(20px,2vw,28px)">
			<span class="vd-divider-line"></span>
			<span class="vd-divider-diamond"></span>
			<span class="vd-divider-line"></span>
		</div>
	</div>

	<!-- ── Commission process ── -->
	<section style="padding-bottom:clamp(46px,6vw,80px)">
		<div class="container">
			<div style="margin-bottom:26px">
				<div class="vd-eyebrow">{t.home.processEyebrow}</div>
				<h2 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(28px,4vw,44px);margin:8px 0 0;color:var(--ink)">{t.process.title}</h2>
			</div>
			<div class="vd-process-cards">
				{t.process.steps.map((step, i) => (
					<div style="border:1px solid var(--line);background:var(--parchment);border-radius:5px;overflow:hidden">
						<div style="position:relative;aspect-ratio:4/3">
							<Picture
								src={processImages[stepImageKeys[i]]}
								alt={t.process.alt[stepImageKeys[i]]}
								formats={['avif', 'webp']}
								fallbackFormat="jpg"
								widths={[400, 640]}
								sizes="(min-width: 920px) 25vw, (min-width: 560px) 50vw, 100vw"
								loading="lazy"
								style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover"
							/>
						</div>
						<div style="padding:16px 16px 18px">
							<div style="display:flex;align-items:baseline;gap:10px">
								<span style="font-family:'Spline Sans Mono',monospace;font-size:12px;letter-spacing:.18em;color:var(--bark)">{step.num}</span>
								<h3 style="font-family:'Cormorant Garamond',serif;font-size:23px;font-weight:600;color:var(--ink);margin:0">{step.title}</h3>
							</div>
							<p style="font-size:14.5px;line-height:1.6;color:#52564c;margin:6px 0 0">{step.short}</p>
						</div>
					</div>
				))}
			</div>
			<div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:26px">
				<a href={p('/contact?type=commission')} class="vd-btn-primary">{t.home.ctaCommission} <span>→</span></a>
				<a href={p('/process')} class="vd-btn-outline">{t.home.processCtaMore}</a>
			</div>
		</div>
	</section>

	<!-- ── Intro band ── -->
	<section style="background:var(--forest);color:#ece4d2">
		<div class="container" style="padding-block:clamp(46px,6vw,84px)">
			<div class="vd-two">
				<div>
					<div style="font-family:'Spline Sans Mono',monospace;font-size:11px;letter-spacing:.26em;text-transform:uppercase;color:var(--gold-soft)">{t.home.bandEyebrow}</div>
					{introArtwork?.coverImage?.original ? (
						<RemoteImage
							image={introArtwork.coverImage}
							alt={introArtwork.coverImage.alt ?? introArtwork.title}
							sizes={IMAGE_SIZES.twoColumn}
							style="max-width:100%;height:auto;border-radius:6px;margin-top:26px;box-shadow:0 12px 32px rgba(0,0,0,.28)"
						/>
					) : (
						<Image src={logoWhite} alt="" width={120} densities={[1, 2]} loading="lazy" style="border-radius:50%;margin-top:26px;opacity:.96" />
					)}
				</div>
				<div>
					<p style="font-family:'Cormorant Garamond',serif;font-style:italic;font-size:clamp(24px,3.2vw,38px);line-height:1.32;margin:0;color:#f3ecdc">{t.home.bandQuote}</p>
					<p style="max-width:58ch;margin:24px 0 0;font-size:16.5px;line-height:1.75;color:#cfc8b6">{t.home.bandText}</p>
					<a href={p('/about')} style="display:inline-flex;align-items:center;gap:9px;margin-top:28px;font-weight:600;font-size:15px;color:var(--gold-soft);transition:color .2s" onmouseover="this.style.color='#fff'" onmouseout="this.style.color='var(--gold-soft)'">{t.home.bandLink}</a>
				</div>
			</div>
		</div>
	</section>

	<!-- ── Series teaser ── -->
	{series.length > 0 && (
		<section>
			<div class="container" style="padding-block:clamp(46px,6vw,80px)">
				<div style="display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:26px">
					<h2 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(28px,4vw,44px);margin:0;color:var(--ink)">{t.home.seriesTitle}</h2>
					<a href={p('/series')} style="font-weight:600;font-size:14px;color:var(--verde-deep);transition:color .2s" onmouseover="this.style.color='var(--ink)'" onmouseout="this.style.color='var(--verde-deep)'">{t.home.seriesLink}</a>
				</div>
				<div class="vd-cards">
					{series.map((s) => {
						const count = artworkCountBySeries[s.id] ?? 0
						const cover = s.coverImage?.original ? s.coverImage : undefined
						return (
							<a
								href={p(`/series/${s.slug}`)}
								style="text-align:left;border:1px solid var(--line);background:var(--parchment);border-radius:5px;overflow:hidden;display:block;text-decoration:none;transition:border-color .25s"
								onmouseover="this.style.borderColor='var(--gold)'"
								onmouseout="this.style.borderColor='var(--line)'"
							>
								{cover ? (
									<RemoteImage image={cover} alt={cover.alt ?? s.name} sizes={IMAGE_SIZES.cards} aspect={IMAGE_ASPECTS.card} style="width:100%;height:150px;object-fit:cover;display:block" />
								) : (
									<div style="height:150px;background:linear-gradient(155deg,#33473b 0%,#5d6b4d 40%,#b68a3c 100%)"></div>
								)}
								<div style="padding:18px 18px 20px">
									<div style="font-family:'Spline Sans Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--bark)">{t.home.seriesCount(count)}</div>
									<div style="font-family:'Cormorant Garamond',serif;font-size:25px;font-weight:600;color:var(--ink);margin-top:6px">{s.name}</div>
									{s.description && <p style="font-size:14px;line-height:1.6;color:#52564c;margin:8px 0 0">{s.description}</p>}
								</div>
							</a>
						)
					})}
				</div>
			</div>
		</section>
	)}

</BaseLayout>
