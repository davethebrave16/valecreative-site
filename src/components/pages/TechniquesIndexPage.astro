---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getTechniques } from '@/lib/fetchContent'
import { useTranslations, getLocalePath, type Locale } from '@/i18n/utils'
import type { Technique, TechniqueCategory } from '@/lib/types'

interface Props {
	locale: string
}

const { locale } = Astro.props
const t = useTranslations(locale)
const p = (path: string) => getLocalePath(locale, path)

const techniques = await getTechniques(locale as Locale)

const CATEGORY_ORDER: TechniqueCategory[] = ['painting', 'engraving', 'craft', 'drawing', 'photography', 'other']

const groupedByCategory = CATEGORY_ORDER.map((category) => ({
	category,
	items: techniques.filter((tech) => tech.category === category),
})).filter((group) => group.items.length > 0)

const pageTitle = locale === 'it' ? 'Tecniche di pittura, incisione e artigianato' : 'Painting, printmaking and craft techniques'
---

<BaseLayout title={pageTitle} lang={locale} description={t.meta.techniquesDescription}>
	<section class="vd-rise" style="padding:clamp(34px,5vw,64px) 0 clamp(50px,6vw,90px)">
		<div class="container">
			<div class="vd-eyebrow">{t.techniques.eyebrow}</div>
			<h1 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(34px,5.5vw,62px);margin:10px 0 0;color:var(--ink)">{t.techniques.title}</h1>
			<p style="max-width:60ch;margin:14px 0 36px;font-size:16px;line-height:1.65;color:#52564c">{t.techniques.subtitle}</p>

			{techniques.length === 0 ? (
				<p style="color:var(--muted)">{t.techniques.empty}</p>
			) : (
				<div class="vd-technique-groups" style="display:grid;grid-template-columns:1fr;gap:0;border-top:1px solid var(--line)">
					{groupedByCategory.map(({ category, items }) => (
						<details class="vd-technique-group">
							<summary style="display:flex;align-items:center;justify-content:space-between;gap:16px;padding:clamp(18px,2.2vw,26px) 0;border-bottom:1px solid var(--line);cursor:pointer;list-style:none">
								<span style="display:flex;align-items:center;gap:14px">
									<span class="vd-chevron" style="width:9px;height:9px;border-right:1px solid var(--gold);border-bottom:1px solid var(--gold);transform:rotate(-45deg);flex:none;transition:transform .2s"></span>
									<h2 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(24px,3vw,34px);margin:0;color:var(--ink)">{t.techniques.category[category] ?? category}</h2>
								</span>
								<span style="font-family:'Spline Sans Mono',monospace;font-size:12px;letter-spacing:.1em;color:var(--muted)">{String(items.length).padStart(2, '0')}</span>
							</summary>
							<div style="display:grid;grid-template-columns:1fr;gap:0">
								{items.map((tech: Technique) => (
									<a
										href={p(`/techniques/${tech.slug}`)}
										style="display:grid;grid-template-columns:24px 1fr;gap:clamp(14px,2vw,30px);align-items:start;padding:clamp(18px,2.2vw,26px) 0;border-bottom:1px solid var(--line);text-decoration:none;transition:opacity .2s"
										onmouseover="this.style.opacity='.75'"
										onmouseout="this.style.opacity='1'"
									>
										<span style="width:9px;height:9px;border:1px solid var(--gold);transform:rotate(45deg);flex:none;margin-top:8px"></span>
										<div style="display:grid;grid-template-columns:1fr;gap:6px">
											<h3 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(20px,2.4vw,26px);margin:0;color:var(--ink)">{tech.name}</h3>
											{tech.description && (
												<p style="max-width:64ch;margin:4px 0 0;font-size:15.5px;line-height:1.7;color:#52564c">{tech.description}</p>
											)}
										</div>
									</a>
								))}
							</div>
						</details>
					))}
				</div>
			)}
		</div>
	</section>
</BaseLayout>

<style>
	.vd-technique-group > summary::-webkit-details-marker {
		display: none;
	}
	.vd-technique-group[open] > summary .vd-chevron {
		transform: rotate(45deg);
	}
</style>
