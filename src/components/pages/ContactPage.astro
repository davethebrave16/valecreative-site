---
import BaseLayout from '@/layouts/BaseLayout.astro'
import CommissionRequestForm from '@/components/CommissionRequestForm'
import ContactAlternatives from '@/components/ContactAlternatives.astro'
import { useTranslations, getLocalePath } from '@/i18n/utils'

interface Props {
	locale: string
}

const { locale } = Astro.props
const t = useTranslations(locale)
const p = (path: string) => getLocalePath(locale, path)

const pageTitle = locale === 'it' ? 'Contattami — Valentina Damiano' : 'Contact — Valentina Damiano'
---

<BaseLayout title={pageTitle} lang={locale} description={t.meta.contactDescription}>
	<section class="vd-rise" style="padding:clamp(34px,5vw,64px) 0 clamp(50px,6vw,90px)">
		<div class="container">
			<div style="position:relative">
				<span style="position:absolute;left:-26px;top:-18px;width:70px;height:70px;border-radius:50%;background:conic-gradient(from 180deg,var(--rose),var(--syellow),var(--sblue),var(--rose));filter:blur(20px);opacity:.3;pointer-events:none"></span>

				<div class="vd-eyebrow">{t.commissions.eyebrow}</div>
				<h1 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(34px,5.5vw,62px);margin:10px 0 0;color:var(--ink)">{t.commissions.title}</h1>
				<p style="max-width:52ch;margin:14px 0 0;font-size:16.5px;line-height:1.7;color:#52564c">{t.commissions.subtitle}</p>
				<p style="max-width:52ch;margin:10px 0 28px;font-size:15px;line-height:1.6;color:#52564c">
					{t.commissions.processLinkLead}{' '}
					<a href={p('/process')} style="font-weight:600;color:var(--verde);transition:color .2s" onmouseover="this.style.color='var(--verde-deep)'" onmouseout="this.style.color='var(--verde)'">{t.commissions.processLinkLabel}</a>
				</p>
			</div>

			<p class="vd-contact-hint">
				{t.contactAlternatives.hint}{' '}
				<a href="#alt-contact">{t.contactAlternatives.hintLink}</a>
			</p>

			<div class="vd-contact-layout">
				<!-- Form -->
				<div>
					<CommissionRequestForm
						client:visible
						labels={t.commissions}
					/>
				</div>

				<aside class="vd-contact-aside">
					<ContactAlternatives locale={locale} />
				</aside>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.vd-contact-hint {
		margin: 0 0 20px;
		font-size: 14.5px;
		line-height: 1.6;
		color: #52564c;
	}
	.vd-contact-hint a {
		font-weight: 600;
		color: var(--verde);
		white-space: nowrap;
	}
	.vd-contact-layout {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
	}
	@media (min-width: 900px) {
		.vd-contact-hint { display: none; }
		.vd-contact-layout {
			grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
			gap: clamp(32px, 4vw, 64px);
			align-items: start;
		}
		.vd-contact-aside {
			position: sticky;
			top: 96px; /* sticky header (~75px) + gap */
		}
	}
</style>
