---
import BaseLayout from '@/layouts/BaseLayout.astro'
import RemoteImage from '@/components/RemoteImage.astro'
import { IMAGE_SIZES, IMAGE_ASPECTS } from '@/lib/remoteImage'
import { getArtworks, getCategories } from '@/lib/fetchContent'
import { useTranslations, getLocalePath, type Locale } from '@/i18n/utils'

interface Props {
	locale: string
}

const { locale } = Astro.props
const t = useTranslations(locale)
const p = (path: string) => getLocalePath(locale, path)

const [allArtworks, categories] = await Promise.all([
	getArtworks(locale as Locale),
	getCategories(locale as Locale),
])

const artworksById = Object.fromEntries(allArtworks.map((a) => [a.id, a]))

const countById: Record<string, number> = {}
for (const a of allArtworks) {
	for (const catId of a.categoryIds ?? []) {
		countById[catId] = (countById[catId] ?? 0) + 1
	}
}

// Only show categories that actually have at least one linked artwork
const visibleCategories = categories
	.map((c) => ({
		...c,
		count: countById[c.id] ?? 0,
		coverImage: c.featuredArtworkId ? artworksById[c.featuredArtworkId]?.coverImage : undefined,
	}))
	.filter((c) => c.count > 0)

const GRADS = [
	'linear-gradient(155deg,#33473b 0%,#5d6b4d 40%,#b68a3c 100%)',
	'radial-gradient(120% 110% at 72% 18%,#c98f5a 0%,#4a5640 50%,#20281f 100%)',
	'linear-gradient(160deg,#2e403a 0%,#7d8a6a 54%,#e3c277 100%)',
	'radial-gradient(120% 120% at 40% 82%,#b68a3c 0%,#5a4632 42%,#232e26 100%)',
]

const pageTitle = locale === 'it' ? 'Opere — Galleria di Pittura' : 'Works — Painting Gallery'
---

<BaseLayout title={pageTitle} lang={locale} description={t.meta.worksDescription}>
	<section class="vd-rise" style="padding:clamp(34px,5vw,64px) 0 clamp(50px,6vw,90px)">
		<div class="container">
			<div class="vd-eyebrow">{t.works.eyebrow}</div>
			<h1 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(34px,5.5vw,62px);margin:10px 0 0;color:var(--ink)">{t.works.title}</h1>
			<p style="max-width:58ch;margin:14px 0 0;font-size:16px;line-height:1.65;color:#52564c">{t.works.subtitle}</p>

			{visibleCategories.length === 0 ? (
				<p style="color:var(--muted);margin-top:2rem">{t.works.empty}</p>
			) : (
				<div class="vd-cards" style="margin-top:clamp(28px,4vw,44px)">
					{visibleCategories.map((cat, i) => {
						const cover = cat.coverImage?.original ? cat.coverImage : undefined
						return (
							<a
								href={p(`/works/category/${cat.slug}`)}
								style="text-align:left;border:1px solid var(--line);background:var(--parchment);border-radius:5px;overflow:hidden;display:block;text-decoration:none;transition:border-color .25s"
								onmouseover="this.style.borderColor='var(--gold)'"
								onmouseout="this.style.borderColor='var(--line)'"
							>
								{cover ? (
									<RemoteImage image={cover} alt={cover.alt ?? cat.name} sizes={IMAGE_SIZES.cards} aspect={IMAGE_ASPECTS.card} style="width:100%;height:210px;object-fit:cover;display:block" />
								) : (
									<div style={`height:210px;background:${GRADS[i % GRADS.length]}`}></div>
								)}
								<div style="padding:20px">
									<div style="font-family:'Spline Sans Mono',monospace;font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--bark)">{t.works.categoryCount(cat.count)}</div>
									<div style="font-family:'Cormorant Garamond',serif;font-size:27px;font-weight:600;color:var(--ink);margin-top:6px">{cat.name}</div>
									<span style="display:inline-block;margin-top:14px;font-weight:600;font-size:14px;color:var(--verde)">{t.works.openCategory}</span>
								</div>
							</a>
						)
					})}
				</div>
			)}
		</div>
	</section>
</BaseLayout>
