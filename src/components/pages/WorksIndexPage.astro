---
import BaseLayout from '@/layouts/BaseLayout.astro'
import WorksGrid from '@/components/WorksGrid'
import { getArtworks, getPublishedSeries, getTechniques, getCategories } from '@/lib/fetchContent'
import { useTranslations, type Locale } from '@/i18n/utils'
import { sortByPosition } from '@/lib/utils'

interface Props {
	locale: string
}

const { locale } = Astro.props
const t = useTranslations(locale)

const [fetchedArtworks, series, techniques, categories] = await Promise.all([
	getArtworks(locale as Locale),
	getPublishedSeries(),
	getTechniques(locale as Locale),
	getCategories(locale as Locale),
])

// Sorted by galleryPosition so WorksGrid's client-side origin filter (personal/commissioned
// tabs) preserves the correct per-origin order without needing its own sort.
const artworks = sortByPosition(fetchedArtworks, 'galleryPosition')

// Build lookup maps
const seriesById = Object.fromEntries(series.map((s) => [s.id, s.name]))
const techniqueById = Object.fromEntries(techniques.map((t) => [t.id, t.name]))
const artworksById = Object.fromEntries(artworks.map((a) => [a.id, a]))

// Resolve each category's featured artwork cover image for the category tile grid
const categoriesWithCover = categories.map((c) => ({
	...c,
	coverImage: c.featuredArtworkId ? artworksById[c.featuredArtworkId]?.coverImage : undefined,
}))

// Enrich artworks for the client component
const workItems = artworks.map((a) => ({
	id: a.id,
	title: a.title,
	slug: a.slug,
	year: a.year,
	availability: a.availability,
	origin: a.origin,
	categoryIds: a.categoryIds,
	dimensions: a.dimensions,
	coverImage: a.coverImage,
	seriesName: a.seriesId ? seriesById[a.seriesId] : undefined,
	techniqueName: a.techniqueId ? techniqueById[a.techniqueId] : undefined,
}))

const pageTitle = locale === 'it' ? 'Opere — Galleria di Pittura' : 'Works — Painting Gallery'
---

<BaseLayout title={pageTitle} lang={locale} description={t.meta.worksDescription}>
	<section class="vd-rise" style="padding:clamp(34px,5vw,64px) 0 clamp(50px,6vw,90px)">
		<div class="container">
			<div class="vd-eyebrow">{t.works.eyebrow}</div>
			<h1 style="font-family:'Cormorant Garamond',serif;font-weight:600;font-size:clamp(34px,5.5vw,62px);margin:10px 0 0;color:var(--ink)">{t.works.title}</h1>
			<p style="max-width:58ch;margin:14px 0 0;font-size:16px;line-height:1.65;color:#52564c">{t.works.subtitle}</p>

			{artworks.length === 0 ? (
				<p style="color:var(--muted);margin-top:2rem">{t.works.empty}</p>
			) : (
				<WorksGrid
					client:visible
					artworks={workItems}
					categories={categoriesWithCover}
					locale={locale}
					labels={{
						filterPersonal: t.works.filterPersonal,
						filterCommissioned: t.works.filterCommissioned,
						countSuffix: t.works.countSuffix,
						legendAvailable: t.works.legendAvailable,
						legendSold: t.works.legendSold,
						selectCategoryHint: t.works.selectCategoryHint,
						availability: t.works.availability,
						orientation: t.works.orientation,
					}}
				/>
			)}
		</div>
	</section>
</BaseLayout>
