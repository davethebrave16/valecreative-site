---
// Responsive AVIF (+ WebP fallback) <picture> for Firebase Storage images, generated at build time.
// `sizes` is required: it must describe the rendered width in the surrounding layout.
import { Picture } from 'astro:assets'
import { blurHashToDataUri } from '@/lib/blurHashUtils'
import { remoteImageOptions } from '@/lib/remoteImage'
import type { ImageObject } from '@/lib/types'

interface Props {
	image: ImageObject
	sizes: string
	alt?: string
	// LCP element: eager + high fetch priority. Everything else lazy-loads.
	priority?: boolean
	// Crop to this width/height ratio when the box uses object-fit: cover (see IMAGE_ASPECTS).
	aspect?: number
	class?: string
	style?: string
}

const { image, sizes, alt, priority = false, aspect, class: className, style = '' } = Astro.props

// Tiny (8×6) BlurHash backdrop, painted until the real image arrives.
const placeholder = image.blurHash ? blurHashToDataUri(image.blurHash, 8, 6) : ''
const imgStyle = placeholder
	? `background:url('${placeholder}') center/cover no-repeat;${style}`
	: style
---

<Picture
	{...remoteImageOptions(image, aspect)}
	formats={['avif']}
	fallbackFormat="webp"
	sizes={sizes}
	alt={alt ?? image.alt ?? ''}
	loading={priority ? 'eager' : 'lazy'}
	fetchpriority={priority ? 'high' : undefined}
	decoding="async"
	class={className}
	style={imgStyle}
/>
