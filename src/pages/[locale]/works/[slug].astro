---
import WorkDetailPage from '@/components/pages/WorkDetailPage.astro'
import { getArtworks } from '@/lib/fetchContent'
import { locales } from '@/i18n/utils'
import type { Artwork } from '@/lib/types'

export async function getStaticPaths() {
	const paths = await Promise.all(
		locales.map(async (locale) => {
			const artworks = await getArtworks(locale)
			return artworks.map((artwork) => ({
				params: { locale, slug: artwork.slug },
				props: { artwork },
			}))
		})
	)
	return paths.flat()
}

interface Props {
	artwork: Artwork
}

const { locale } = Astro.params
const { artwork } = Astro.props
---

<WorkDetailPage locale={locale} artwork={artwork} />
